generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// enums replaced with String for SQLite compat
// ProjectMode: CREATOR | BUSINESS
// ProjectStatus: DRAFT | ANALYZING | PROCESSING | RENDERING | COMPLETED | FAILED
// AssetType: VIDEO | IMAGE | AUDIO | MUSIC | BRAND
// RenderStatus: QUEUED | PREVIEW_RENDERING | PREVIEW_READY | FINAL_RENDERING | FINAL_READY | FAILED
// AspectRatio: VERTICAL_9_16 | SQUARE_1_1 | PORTRAIT_4_5
// Platform: INSTAGRAM | TIKTOK | YOUTUBE | LINKEDIN
// PublishStatus: PENDING | SCHEDULED | PUBLISHED | FAILED
// Role: OWNER | ADMIN | MEMBER
// Plan: FREE | PRO | TEAM | ENTERPRISE

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  avatarUrl     String?
  workspaces    WorkspaceMember[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clerkId])
  @@index([email])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("FREE")
  members     WorkspaceMember[]
  projects    Project[]
  brandKits   BrandKit[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model WorkspaceMember {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  role         String   @default("MEMBER")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id              String       @id @default(cuid())
  workspaceId     String
  name            String
  mode            String       @default("CREATOR")
  status          String       @default("DRAFT")
  targetDuration  Int?
  aspectRatio     String       @default("VERTICAL_9_16")

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  referenceReels  ReferenceReel[]
  assets          Asset[]
  voiceSegments   VoiceSegment[]
  styleDNA        String?
  edl             String?
  outputReels     OutputReel[]
  publishJobs     PublishJob[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model ReferenceReel {
  id          String   @id @default(cuid())
  projectId   String
  url         String?
  fileUrl     String?
  platform    String
  analysis    String?
  order       Int
  status      String   @default("pending")
  error       String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Asset {
  id            String   @id @default(cuid())
  projectId     String
  type          String
  url           String
  thumbnailUrl  String?
  duration      Float?
  width         Int?
  height        Int?
  fps           Float?
  fileSize      Int?
  mimeType      String?
  audioUrl      String?
  transcript    String?
  words         String?
  language      String?
  aiTags        String   @default("[]")
  qualityScore  Float?
  scenes        String?
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceSegments VoiceSegment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([type])
}

model VoiceSegment {
  id         String   @id @default(cuid())
  projectId  String
  assetId    String
  start      Float
  end        Float
  transcript String
  label      String?
  confidence Float?
  isPreserved Boolean @default(true)

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([assetId])
}

model OutputReel {
  id          String       @id @default(cuid())
  projectId   String
  version     Int          @default(1)
  status      String       @default("QUEUED")
  url         String?
  previewUrl  String?
  duration    Float?
  aspectRatio String       @default("VERTICAL_9_16")
  settings    String       @default("{}")
  error       String?
  parentId    String?
  parent      OutputReel?  @relation("Variants", fields: [parentId], references: [id])
  variants    OutputReel[] @relation("Variants")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
}

model BrandKit {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  logoUrl         String?
  primaryColor    String   @default("#000000")
  secondaryColor  String   @default("#FFFFFF")
  fontUrl         String?
  fontFamily      String   @default("Inter")
  introTemplate   String?
  outroTemplate   String?
  complianceRules String?
  isDefault       Boolean  @default(false)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
}

model PublishJob {
  id            String   @id @default(cuid())
  projectId     String
  outputReelId  String
  platform      String
  status        String   @default("PENDING")
  externalId    String?
  scheduledAt   DateTime?
  publishedAt   DateTime?
  error         String?
  caption       String?
  hashtags      String   @default("[]")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outputReel    OutputReel @relation(fields: [outputReelId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([outputReelId])
  @@index([status])
}
