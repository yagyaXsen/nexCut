# Clerk Auth (optional for dev - app works without it)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# SQLite dev database (file path relative to apps/web/)
DATABASE_URL="file:/absolute/path/to/packages/db/prisma/dev.db"

# Cloudflare R2 (optional for dev - uploads will fail gracefully)
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=nexcut-media

# OpenAI (optional for dev - style analysis will skip)
OPENAI_API_KEY=placeholder

# Modal (optional for dev - workers will not run)
MODAL_TOKEN_ID=placeholder
MODAL_TOKEN_SECRET=placeholder
