FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libglib2.0-0 \
    libgl1-mesa-glx \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip install --no-cache-dir \
    modal==0.64.0 \
    openai==1.30.0 \
    opencv-python-headless==4.8.1 \
    numpy==1.26.0 \
    librosa==0.10.1 \
    scenedetect==0.6.1 \
    whisper==1.1.10 \
    torch==2.1.0 \
    torchaudio==2.1.0 \
    boto3==1.34.0 \
    python-dotenv==1.0.0 \
    pydantic==2.5.0 \
    httpx==0.25.0 \
    tqdm==4.66.0

WORKDIR /root/nexcut

COPY apps/workers /root/nexcut/apps/workers
COPY packages /root/nexcut/packages

RUN pip install -e /root/nexcut/packages/core
RUN pip install -e /root/nexcut/packages/ffmpeg-dsl

CMD ["modal", "serve", "apps/workers/main.py"]